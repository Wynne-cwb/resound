# macOS
.DS_Store

# Xcode / Swift
.build/
build/
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
.swiftpm/
# 注意：Package.resolved **要提交**（Resound 是应用不是库）。曾被 ignore，结果新用户 clone 后
# fresh resolve 会拉到未验证的上游版本——FluidAudio 0.15.5 移除了我们在用的 DownloadUtils，
# 于是「clone 下来就编译不过」。见 DECISIONS 2026-07-29。

# Derived index (NEVER commit — rebuildable from vault)
*.sqlite
*.sqlite-wal
*.sqlite-shm
index/

# Local config / secrets (API keys, vault paths)
.env
*.local
secrets.*

# Vault working copies (lives in App Support, not in code repo)
vaults/

